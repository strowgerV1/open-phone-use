# Generate distinct keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use keys of at least 24 characters. No real secret belongs in this file.
ENV_API_KEYS='{"alice":"REPLACE_WITH_A_RANDOM_32_BYTE_KEY"}'
ENV_CLIENT_KEY='REPLACE_WITH_THE_SAME_ALICE_KEY'
# Optional, dedicated Android only; never a personal device for shared use.
# ENV_ANDROID_SERIAL=emulator-5554

# Local pilot: capacity shared by browser, desktop and phone leases.
ENV_CAPACITY=6
# JSON file containing registered devices; created empty by strowger init.
# ENV_ANDROID_DEVICES_FILE=data/fleet.json
